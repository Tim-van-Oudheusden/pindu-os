// What the launcher may do as the pindu user without a password: its system panel
// (https://github.com/Tim-van-Oudheusden/pindu-launcher/blob/main/docs/system-panel.md#pindu-os-side),
// its "add a store" flow (docs/decisions/0013-game-sources.md) and Get Games
// (docs/decisions/0015-get-games.md).
// The gamescope session has no polkit agent, so anything that would ask for authentication
// fails there. Fedora's defaults already allow the active session logind's power off, reboot
// and suspend, and NetworkManager's network-control and wifi.scan; this file grants the rest,
// to pindu in an active local session only.
polkit.addRule(function (action, subject) {
    if (subject.user !== "pindu" || !subject.local || !subject.active) {
        return polkit.Result.NOT_HANDLED;
    }

    // Roll back (pindu-os-rollback.service), and no other unit operation through systemd.
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "pindu-os-rollback.service" &&
        action.lookup("verb") === "start") {
        return polkit.Result.YES;
    }

    // Save Wi-Fi networks as system connections, so they come up before login. Fedora's
    // default is auth_admin_keep.
    if (action.id === "org.freedesktop.NetworkManager.settings.modify.system") {
        return polkit.Result.YES;
    }

    // Install and update apps and runtimes from Flathub in the system installation, for the
    // launcher's "add a store" flow and Get Games. flatpak's system helper names the remote in
    // "origin". Fedora's defaults already allow the active session to update apps, refresh
    // remotes and download the Flathub catalogue (appstream-update); installing from any other
    // remote, installing bundles and adding or changing remotes still need an administrator,
    // which this console does not have.
    if ((action.id === "org.freedesktop.Flatpak.app-install" ||
         action.id === "org.freedesktop.Flatpak.runtime-install" ||
         action.id === "org.freedesktop.Flatpak.app-update" ||
         action.id === "org.freedesktop.Flatpak.runtime-update") &&
        action.lookup("origin") === "flathub") {
        return polkit.Result.YES;
    }

    // Uninstall apps and runtimes from the system installation, for Get Games' Remove. The
    // helper passes only the ref here (or the app's name), not its remote; Flathub is the
    // installation's only remote. Runtimes nothing uses any more are removed by
    // pindu-os-flatpak-update.service, as root.
    if (action.id === "org.freedesktop.Flatpak.app-uninstall" ||
        action.id === "org.freedesktop.Flatpak.runtime-uninstall") {
        return polkit.Result.YES;
    }

    return polkit.Result.NOT_HANDLED;
});
