# Every pinned input of the image and of the tools that build and check it.
#
# Scripts, the Justfile and the workflows read this file and never hard-code a version, so a
# diff of it explains any change in the image. Renovate (renovate.json5) opens the bump PRs.
# Format: KEY=value, one per line, no quotes and no spaces, so bash, just and podman parse it.

# Fedora release of the image. pindu-launcher needs GTK 4.24 and libadwaita 1.10, which is
# Fedora 45. A release bump is manual: this value, the base tag, the akmods tag and the
# launcher RPM's dist tag (fc45) move together.
FEDORA_VERSION=45

# Base image: Fedora's upstream bootc image.
BASE_IMAGE=quay.io/fedora/fedora-bootc:45@sha256:d70fb477a35612f651fcfa397f41e2945514374d3fdaaa64b0e75a3ca1da2bbc

# pindu-launcher release RPM from GitHub Releases, and the SHA-256 the build checks it against.
LAUNCHER_VERSION=0.3.0
LAUNCHER_SHA256=961e443e74e3fa00998eb39a9094ae53cde19fcc98b63f02f7e78b1b401efb04

# Kernel: "fedora" keeps the base image's kernel, "ogc" swaps in the Open Gaming Collective
# kernel from the akmods image below (build_files/20-kernel.sh).
KERNEL_FLAVOR=fedora
AKMODS_IMAGE=ghcr.io/ublue-os/akmods:ogc-45@sha256:0389b13eb70761fa46a68f3c80ff693cad76d6f431226d830469d6f464f47d85

# bootc-image-builder, which turns the image into qcow2, raw and installer ISO files.
BIB_IMAGE=quay.io/centos-bootc/bootc-image-builder:latest@sha256:dab86ee6b46dcade411b37f4e70b07d93b6a06da0dbfec6fe89247a220e0d9f8

# Local registry the update test (tests/vm/update.sh) serves images from.
REGISTRY_IMAGE=docker.io/library/registry:3@sha256:82f6ff4a7f982960c8aa51617fea3aabc485df6e55cce80d22deb1de36f1bc3c

# SBOM generator used by build.yml.
SYFT_IMAGE=ghcr.io/anchore/syft:v1.57.1@sha256:03215d0e98b661d0ecbc8575dbc14d65be1743b5de5df6410aecb7e80f95b060

# Linters run by `just lint`, locally and in pr.yml.
SHELLCHECK_IMAGE=docker.io/koalaman/shellcheck:v0.11.0@sha256:61862eba1fcf09a484ebcc6feea46f1782532571a34ed51fedf90dd25f925a8d
HADOLINT_IMAGE=docker.io/hadolint/hadolint:v2.14.0@sha256:27086352fd5e1907ea2b934eb1023f217c5ae087992eb59fde121dce9c9ff21e
ACTIONLINT_IMAGE=docker.io/rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667
ZIZMOR_IMAGE=ghcr.io/zizmorcore/zizmor:1.32.0@sha256:3014cc8f68f663935f69b3c3e0e41f5ce102b268d97db13db0f62208747f860d
